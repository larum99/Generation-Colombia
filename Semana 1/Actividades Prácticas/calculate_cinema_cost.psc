Algoritmo calculate_cinema_cost
	
	Definir value_ticket, total Como Real
	Definir num_tickets Como Entero
	
	Escribir "Ingrese la cantidad de voletas: " 
	Leer num_tickets
	
	value_ticket <- 8000
	total <- num_tickets * value_ticket
	
	Escribir "El total a pagar por las " num_tickets " entradas es: " total
		
FinAlgoritmo
